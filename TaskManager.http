@TaskManager_HostAddress = http://localhost:5196
@token = {{login.response.body.token}}

###
GET {{TaskManager_HostAddress}}/boom

### Complete task with follow-up (success)
POST {{TaskManager_HostAddress}}/tasks/1/complete
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "followUpTitle": "Follow-up task",
  "followUpProjectId": 2
}

### Complete task with follow-up (non-existent project -> rollback)
POST {{TaskManager_HostAddress}}/tasks/2/complete
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "followUpTitle": "Should not exist",
  "followUpProjectId": 999
}

############################################################
# AUTH
############################################################

### Rejestracja -> 201
POST {{TaskManager_HostAddress}}/auth/register
Content-Type: application/json

{
    "username": "bartek",
    "password": "haslo123"
}

### Ta sama nazwa drugi raz -> 409
POST {{TaskManager_HostAddress}}/auth/register
Content-Type: application/json

{
    "username": "bartek",
    "password": "innehaslo"
}

### Drugi uzytkownik z TYM SAMYM haslem -> 201 (porownaj hashe w bazie)
POST {{TaskManager_HostAddress}}/auth/register
Content-Type: application/json

{
    "username": "anna",
    "password": "haslo123"
}

### Za krotkie haslo -> 400
POST {{TaskManager_HostAddress}}/auth/register
Content-Type: application/json

{
    "username": "jan",
    "password": "abc"
}

### Za krotka nazwa -> 400
POST {{TaskManager_HostAddress}}/auth/register
Content-Type: application/json

{
    "username": "ab",
    "password": "haslo123"
}

### Brak hasla -> 400
POST {{TaskManager_HostAddress}}/auth/register
Content-Type: application/json

{
    "username": "jan"
}

### Logowanie poprawne -> 200 + token
# @name login
POST {{TaskManager_HostAddress}}/auth/login
Content-Type: application/json

{
    "username": "bartek",
    "password": "haslo123"
}

### Zle haslo -> 401 (odpowiedz identyczna jak nizej)
POST {{TaskManager_HostAddress}}/auth/login
Content-Type: application/json

{
    "username": "bartek",
    "password": "zlehaslo"
}

### Nieistniejacy uzytkownik -> 401 (odpowiedz identyczna jak wyzej)
POST {{TaskManager_HostAddress}}/auth/login
Content-Type: application/json

{
    "username": "nieistnieje",
    "password": "haslo123"
}

### Logowanie z pustym haslem -> 400
POST {{TaskManager_HostAddress}}/auth/login
Content-Type: application/json

{
    "username": "bartek",
    "password": ""
}

############################################################
# PROJEKTY
# Uwaga: POST /projects zwroci 500 do czesci D (brak UserId)
############################################################

### Projects with tasks (N+1 demo)
GET {{TaskManager_HostAddress}}/projects/with-tasks
Authorization: Bearer {{token}}

### Bez tokenu -> 401
GET {{TaskManager_HostAddress}}/projects

### Zly token -> 401
GET {{TaskManager_HostAddress}}/projects
Authorization: Bearer to.nie.jest.token

### Lista projektow -> 200
GET {{TaskManager_HostAddress}}/projects
Authorization: Bearer {{token}}

### Projekt po id -> 200
GET {{TaskManager_HostAddress}}/projects/1
Authorization: Bearer {{token}}

### Nieistniejacy projekt -> 404
GET {{TaskManager_HostAddress}}/projects/999
Authorization: Bearer {{token}}

### Nowy projekt -> 201 (po czesci D)
POST {{TaskManager_HostAddress}}/projects
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "name": "Toaleta",
    "description": "Posprzątac kibel i wanne"
}

### Projekt bez nazwy -> 400
POST {{TaskManager_HostAddress}}/projects
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "description": "Brak nazwy"
}

### Edycja projektu -> 204
PUT {{TaskManager_HostAddress}}/projects/1
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "name": "Learn German",
    "description": "Nauczyc sie niemieckiego w stopniu komunikatywnym i pisemnym"
}

### Edycja nieistniejacego projektu -> 404
PUT {{TaskManager_HostAddress}}/projects/999
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "name": "Nie istnieje"
}

### Zadania projektu -> 200
GET {{TaskManager_HostAddress}}/projects/1/tasks
Authorization: Bearer {{token}}

### Zadania nieistniejacego projektu -> 404
GET {{TaskManager_HostAddress}}/projects/999/tasks
Authorization: Bearer {{token}}

### Usuniecie projektu -> 204 (powtorzone -> 404)
DELETE {{TaskManager_HostAddress}}/projects/3
Authorization: Bearer {{token}}

############################################################
# ZADANIA
############################################################

### Lista zadan -> 200
GET {{TaskManager_HostAddress}}/tasks
Authorization: Bearer {{token}}

### Zadanie po id -> 200
GET {{TaskManager_HostAddress}}/tasks/2 
Authorization: Bearer {{token}}

### Nieistniejace zadanie -> 404
GET {{TaskManager_HostAddress}}/tasks/999
Authorization: Bearer {{token}}

### Nowe zadanie -> 201
POST {{TaskManager_HostAddress}}/tasks
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "title": "sroda",
    "projectId": 1,
    "dueDate": "2030-01-01T10:00:00Z"
}

### Zadanie bez statusu -> 201, status = 0 (ToDo)
POST {{TaskManager_HostAddress}}/tasks
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "title": "bez statusu",
    "projectId": 1
}

### Zadanie do nieistniejacego projektu -> 400
POST {{TaskManager_HostAddress}}/tasks
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "title": "poniedzialek",
    "projectId": 999
}

### Termin w przeszlosci -> 400
POST {{TaskManager_HostAddress}}/tasks
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "title": "poniedzialek",
    "projectId": 1,
    "dueDate": "2020-01-01"
}

### Brak tytulu -> 400
POST {{TaskManager_HostAddress}}/tasks
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "projectId": 1
}

### projectId = 0 -> 400
POST {{TaskManager_HostAddress}}/tasks
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "title": "zly projekt",
    "projectId": 0
}

### Tekst zamiast liczby -> 400 (nie 500)
POST {{TaskManager_HostAddress}}/tasks
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "title": "zly typ",
    "projectId": "abc"
}

### Edycja zadania -> 204
PUT {{TaskManager_HostAddress}}/tasks/1
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "title": "jednak wtorek",
    "status": 1,
    "projectId": 1
}

### Edycja nieistniejacego zadania -> 404
PUT {{TaskManager_HostAddress}}/tasks/999
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "title": "nie istnieje",
    "projectId": 1
}

### Edycja z nieistniejacym projektem -> 400
PUT {{TaskManager_HostAddress}}/tasks/1
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "title": "zly projekt",
    "projectId": 999
}

### Usuniecie zadania -> 204 (powtorzone -> 404)
DELETE {{TaskManager_HostAddress}}/tasks/1
Authorization: Bearer {{token}}

############################################################
# FILTROWANIE I SORTOWANIE
############################################################

### Filtr po projekcie
GET {{TaskManager_HostAddress}}/tasks?projectId=1
Authorization: Bearer {{token}}

### Filtr po statusie (nazwa)
GET {{TaskManager_HostAddress}}/tasks?status=Done
Authorization: Bearer {{token}}

### Filtr po statusie (liczba) -> to samo co wyzej
GET {{TaskManager_HostAddress}}/tasks?status=2
Authorization: Bearer {{token}}

### Oba filtry naraz
GET {{TaskManager_HostAddress}}/tasks?status=Done&projectId=1
Authorization: Bearer {{token}}

### Sortowanie po terminie (zadania bez terminu na koncu)
GET {{TaskManager_HostAddress}}/tasks?orderBy=duedate&status=0
Authorization: Bearer {{token}}

### Sortowanie po tytule (wielkosc liter bez znaczenia)
GET {{TaskManager_HostAddress}}/tasks?orderBy=TITLE
Authorization: Bearer {{token}}

### Sortowanie po statusie
GET {{TaskManager_HostAddress}}/tasks?orderBy=status
Authorization: Bearer {{token}}
